---
// Nhóm nút chọn một (radio) dạng segmented — thuần CSS; trang/CSS đọc trạng thái qua :has(#id:checked).
interface Option {
  id: string;
  label: string;
}
interface Props {
  name: string;
  label: string;
  options: Option[];
  checked: string; // id mặc định
  /** Nhiều lựa chọn / màn hẹp: các nút tách rời và xuống dòng thay vì một dải liền bị cắt. */
  wrap?: boolean;
}
const { name, label, options, checked, wrap = false } = Astro.props;
// label `relative`: input sr-only (position: absolute) neo trong nút, không tràn ngang trang
const item = "relative cursor-pointer px-3 py-1 whitespace-nowrap has-checked:bg-primary has-checked:text-surface has-focus-visible:outline-2 has-focus-visible:outline-primary";
---

<div class:list={["flex gap-3", wrap ? "items-baseline" : "items-center"]} role="radiogroup" aria-label={label}>
  <span class="shrink-0">{label}:</span>
  <div class:list={wrap ? "flex flex-wrap gap-1.5" : "inline-flex overflow-hidden rounded-md border border-line"}>
    {
      options.map((o) => (
        <label class:list={[item, wrap && "rounded-md border border-line has-checked:border-primary"]}>
          <input type="radio" name={name} id={o.id} class="sr-only" checked={o.id === checked} />
          {o.label}
        </label>
      ))
    }
  </div>
</div>
