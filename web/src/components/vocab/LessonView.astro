---
// Trang một bài từ vựng (dùng chung Minna và N3): thanh chuyển bài, bảng "Hiển thị", danh sách thẻ.
// Trang (pages/) lấy dữ liệu rồi truyền vào — component không gọi getCollection.
import type { VocabEntry } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { clip } from "../../lib/seo";
import { partNumbers } from "../../lib/vocab-parts";
import Segmented from "../ui/Segmented.astro";
import type { NavLink } from "./CardNav.astro";
import WordCard from "./WordCard.astro";

interface Props {
  lesson: number;
  entries: VocabEntry[];
  route: string; // đường dẫn bài, vd "vocabulary" hoặc "vocabulary/n3" (không có "/" đầu/cuối)
  lastLesson: number;
  label: string; // tiền tố tên bài, vd "Bài" hoặc "N3 · Bài"
  conj: Map<string, string>; // vocab_id → trang chia thể (không có "/" đầu), chỉ động từ / tính từ
  counters?: Map<string, string>; // vocab_id → trang trợ số từ (không có "/" đầu)
}
const { lesson: n, entries, route, lastLesson, label, conj, counters = new Map<string, string>() } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const lessonHref = (k: number): string => `${base}/${route}/${k}/`;
// Trang danh sách bài cùng cấp: N3 có route riêng; Minna 1–25 → N5, 26–50 → N4
const listHref = `${base}/${route === "vocabulary" ? `vocabulary/${n <= 25 ? "n5" : "n4"}` : route}/`;
// Quiz từ vựng lọc sẵn đúng bài này (D6)
const quizLevel = route === "vocabulary" ? (n <= 25 ? "n5" : "n4") : "n3";
const quizHref = `${base}/vocabulary/quiz/?cap=${quizLevel}&tu=${n}&den=${n}`;

// Chế độ "Từng thẻ": nút Trước/Sau là link #id (CSS :target), quay vòng trong bài (cuối → đầu, đầu → cuối).
// Chuyển bài dùng nút ở header. Thứ tự ngẫu nhiên do script cuối file xử lý.
const navOf = (i: number): { prev: NavLink; next: NavLink } => {
  const k = entries.length;
  return {
    prev: { href: `#${entries[(i - 1 + k) % k]?.id}`, label: "Trước" },
    next: { href: `#${entries[(i + 1) % k]?.id}`, label: "Sau" },
  };
};

// Học theo phần: bài dài chia 2–3 phần liên tiếp (≤ 20 từ giữ nguyên). Lọc bằng CSS (global.css, data-part),
// script cuối file giới hạn Trước/Sau, số đếm, Ngẫu nhiên trong phần và ghi URL ?phan=N.
const parts = partNumbers(entries);
const partSizes = parts.reduce<number[]>((acc, p) => ((acc[p - 1] = (acc[p - 1] ?? 0) + 1), acc), []);
const partOptions = [
  { id: "part-all", label: "Tất cả" },
  ...partSizes.map((size, i) => ({ id: `part-${i + 1}`, label: `Phần ${i + 1} (${size})` })),
];

const toggles = [
  { id: "toggle-furigana", label: "Ẩn furigana" },
  { id: "toggle-vocab-reading", label: "Hiện furigana từ vựng" }, // chỉ dùng được khi đang Ẩn furigana
  { id: "toggle-vi", label: "Che bản dịch (rê chuột để xem)" },
];
const navLink = "rounded px-2 py-1 text-primary hover:bg-primary-soft";
const book = route === "vocabulary" ? "みんなの日本語" : "N3";
const description = clip(
  `Từ vựng ${book} ${label.replace(/^N3 · /, "")} ${n}: ${entries.length} từ có nghĩa tiếng Việt, furigana, câu ví dụ — ${entries
    .slice(0, 8)
    .map((e) => `${e.kanji ?? e.kana} (${e.meaning_vi})`)
    .join(", ")}.`,
);
---

<Base title={`Từ vựng ${label} ${n}`} description={description}>
  <nav slot="header" class="ml-auto flex items-center gap-2 text-sm">
    {n > 1 && <a href={lessonHref(n - 1)} class={navLink}>← Bài {n - 1}</a>}
    <a href={listHref} class={navLink} title="Danh sách bài cùng cấp">{label} {n}</a>
    {n < lastLesson && <a href={lessonHref(n + 1)} class={navLink}>Bài {n + 1} →</a>}
  </nav>

  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h1 class="text-2xl font-bold">
      {label} {n} <span class="text-base font-normal text-ink-faint">· {entries.length} từ</span>
    </h1>
    <a href={quizHref} class="rounded-md border border-primary px-3 py-1 text-sm font-semibold text-primary hover:bg-primary-soft" data-lesson-quiz>
      Luyện tập bài này →
    </a>
  </div>

  <fieldset class="display-panel mt-3 flex flex-wrap gap-x-5 gap-y-2 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink-muted">
    <legend class="px-1 text-xs text-ink-faint">Hiển thị</legend>
    {/* Mobile (< md): nhóm chọn một thu gọn sau nút này, chỉ để lại 3 ô bật/tắt. Nút ghi tóm tắt lựa chọn hiện tại
        (script cuối file cập nhật). PC: nút ẩn, luôn mở. CSS ở global.css (.display-panel). */}
    <label class="display-opts-btn flex w-full cursor-pointer items-center justify-between gap-2 rounded-md border border-line px-3 py-1.5 text-ink md:hidden">
      <input type="checkbox" id="toggle-display-opts" class="sr-only" aria-controls="display-opts" />
      <span class="min-w-0 truncate" data-display-summary>Lưới · Tuần tự · Kanji</span>
      <span class="display-opts-chevron shrink-0 text-ink-faint" aria-hidden="true">▾</span>
    </label>
    <div id="display-opts" class="display-opts flex w-full flex-wrap items-center gap-x-6 gap-y-2">
      <Segmented
        name="view"
        label="Chế độ xem"
        checked="view-grid"
        options={[
          { id: "view-grid", label: "Lưới" },
          { id: "view-single", label: "Từng thẻ" },
        ]}
      />
      <Segmented
        name="order"
        label="Thứ tự"
        checked="order-seq"
        options={[
          { id: "order-seq", label: "Tuần tự" },
          { id: "order-random", label: "Ngẫu nhiên" },
        ]}
      />
      <Segmented
        name="focus"
        label="Nhấn mạnh từ vựng"
        checked="focus-kanji"
        options={[
          { id: "focus-kanji", label: "Kanji" },
          { id: "focus-kana", label: "Hiragana" },
        ]}
      />
      {partSizes.length > 1 && <Segmented name="part" label="Học theo phần" checked="part-all" options={partOptions} wrap />}
    </div>
    {
      toggles.map((t) => (
        <label class="flex cursor-pointer items-center gap-2 has-disabled:cursor-not-allowed has-disabled:opacity-50">
          <input type="checkbox" id={t.id} class="accent-primary" />
          {t.label}
        </label>
      ))
    }
  </fieldset>

  <div class="word-list mt-4 grid gap-3 md:grid-cols-2">
    {entries.map((w, i) => <WordCard word={w} index={i + 1} total={entries.length} conjHref={conj.has(w.id) ? `${base}/${conj.get(w.id)}` : null} counterHref={counters.has(w.id) ? `${base}/${counters.get(w.id)}` : null} part={parts[i] ?? 1} {...navOf(i)} />)}
  </div>
</Base>

<script>
  // 1) Chế độ Lưới: click một thẻ → chuyển sang "Từng thẻ" và mở đúng thẻ đó (không lật).
  // 2) Nút Trước/Sau (data-step) đi theo thứ tự đang chọn: tuần tự hoặc ngẫu nhiên (xáo trộn mỗi lần bật).
  // Không JS: link #id vẫn chạy tuần tự + quay vòng.
  const ids = [...document.querySelectorAll<HTMLElement>(".word-list .word-card")].map((el) => el.id);
  const viewSingle = document.getElementById("view-single") as HTMLInputElement | null;
  const viewGrid = document.getElementById("view-grid") as HTMLInputElement | null;
  const random = document.getElementById("order-random") as HTMLInputElement | null;

  // Học theo phần: `order` chỉ gồm thẻ của phần đang chọn (thẻ khác bị CSS ẩn theo data-part).
  const partOf = new Map(ids.map((id) => [id, document.getElementById(id)?.dataset.part ?? "1"]));
  const partRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="part"]')];
  const selectedPart = (): string | null => {
    const r = partRadios.find((x) => x.checked);
    return r && r.id !== "part-all" ? r.id.slice("part-".length) : null;
  };
  const inPart = (): string[] => {
    const p = selectedPart();
    return p ? ids.filter((id) => partOf.get(id) === p) : [...ids];
  };
  // ?phan=N khi mở trang (link chia sẻ) → chọn sẵn phần đó
  const phan = new URLSearchParams(location.search).get("phan");
  const initial = phan ? (document.getElementById(`part-${phan}`) as HTMLInputElement | null) : null;
  if (initial && partRadios.includes(initial)) initial.checked = true;
  let order = inPart();
  // Nút quiz: đang chọn một phần → "Luyện tập phần này" (quiz lọc &phan=N)
  const quizLink = document.querySelector<HTMLAnchorElement>("[data-lesson-quiz]");
  const quizBase = quizLink?.getAttribute("href") ?? "";
  const syncQuizLink = (): void => {
    if (!quizLink) return;
    const p = selectedPart();
    quizLink.setAttribute("href", p ? `${quizBase}&phan=${p}` : quizBase);
    quizLink.textContent = p ? "Luyện tập phần này →" : "Luyện tập bài này →";
  };
  syncQuizLink();

  const shuffle = (): string[] => {
    const a = inPart();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j] as string, a[i] as string];
    }
    return a;
  };
  // Thẻ đang xem do JS quản lý (class .is-current) thay vì :target → đổi thẻ KHÔNG cuộn trang (hết co giật).
  // URL #id vẫn cập nhật bằng history.pushState (không cuộn) để chia sẻ link / nút Back hoạt động.
  const list = document.querySelector<HTMLElement>(".word-list");
  list?.classList.add("js-cards");
  const fromHash = (): string | null => {
    const h = decodeURIComponent(location.hash.slice(1));
    return order.includes(h) ? h : null;
  };
  let cur = fromHash() ?? order[0] ?? "";
  const current = (): string => cur;
  const updateCounter = (): void => {
    const pos = document.getElementById(cur)?.querySelector(".card-pos");
    if (pos) pos.textContent = `${order.indexOf(cur) + 1} / ${order.length}`;
  };
  const show = (id: string): void => {
    document.querySelector(".word-card.is-current")?.classList.remove("is-current");
    document.getElementById(id)?.classList.add("is-current");
    cur = id;
    updateCounter();
  };
  const go = (id: string, scroll = false): void => {
    const flip = document.getElementById(`flip-${id}`) as HTMLInputElement | null;
    if (flip) flip.checked = false; // luôn mở thẻ ở mặt trước
    show(id);
    if (location.hash.slice(1) !== id) history.pushState(null, "", `#${id}`);
    if (scroll) document.getElementById(id)?.scrollIntoView({ block: "start" });
  };
  show(cur);

  // "Che bản dịch": chạm/click vào dòng bị che → bật/tắt hiện (cần cho mobile, không có hover).
  // Bắt ở pha capture và chặn lan truyền để click KHÔNG lật thẻ / chuyển Lưới → Từng thẻ.
  const toggleVi = document.getElementById("toggle-vi") as HTMLInputElement | null;
  window.addEventListener(
    "click",
    (e) => {
      if (!toggleVi?.checked) return;
      const vi = (e.target as HTMLElement).closest<HTMLElement>(".example-vi");
      if (!vi) return;
      e.preventDefault();
      e.stopPropagation();
      vi.classList.toggle("is-revealed");
    },
    true,
  );
  // "Hiện furigana từ vựng" chỉ dùng được khi đang "Ẩn furigana"; bỏ Ẩn → tự bỏ chọn + khóa.
  // Chạy cả lúc tải trang (trình duyệt có thể khôi phục trạng thái checkbox khi bấm Back).
  const furi = document.getElementById("toggle-furigana") as HTMLInputElement | null;
  const vocabReading = document.getElementById("toggle-vocab-reading") as HTMLInputElement | null;
  const syncVocabReading = (): void => {
    if (!furi || !vocabReading) return;
    if (!furi.checked) vocabReading.checked = false;
    vocabReading.disabled = !furi.checked;
  };
  syncVocabReading();
  furi?.addEventListener("change", syncVocabReading);

  toggleVi?.addEventListener("change", () => {
    document.querySelectorAll(".example-vi.is-revealed").forEach((el) => el.classList.remove("is-revealed"));
  });

  // Chuyển ±1 thẻ theo thứ tự đang chọn, quay vòng. `slide` (khi vuốt): thẻ mới trượt vào từ phía vuốt.
  const step = (d: number, slide = false): void => {
    const i = order.indexOf(current());
    const k = order.length;
    const id = order[(i + d + k) % k] ?? "";
    go(id);
    if (!slide) return;
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove("swipe-in-next", "swipe-in-prev");
    void el.offsetWidth; // reflow → chạy lại animation khi vuốt liên tục
    el.classList.add(d > 0 ? "swipe-in-next" : "swipe-in-prev");
  };
  list?.addEventListener("animationend", (e) => (e.target as HTMLElement).classList.remove("swipe-in-next", "swipe-in-prev"));

  // Vuốt ngang ở chế độ Từng thẻ: trái → thẻ sau, phải → thẻ trước. Chỉ nhận khi kéo ngang ≥ 50px và rõ ràng
  // theo chiều ngang (|dx| ≥ 1.5|dy|) → cuộn dọc mặt sau và chạm để lật vẫn như cũ.
  let touch: { x: number; y: number; t: number } | null = null;
  list?.addEventListener(
    "touchstart",
    (e) => {
      const p = e.touches[0];
      touch = viewSingle?.checked && e.touches.length === 1 && p ? { x: p.clientX, y: p.clientY, t: e.timeStamp } : null;
    },
    { passive: true },
  );
  list?.addEventListener(
    "touchend",
    (e) => {
      const p = e.changedTouches[0];
      const s = touch;
      touch = null;
      if (!s || !p || e.timeStamp - s.t > 800) return;
      const dx = p.clientX - s.x;
      const dy = p.clientY - s.y;
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      step(dx < 0 ? 1 : -1, true);
    },
    { passive: true },
  );

  // Nút bảng "Hiển thị" (mobile): tóm tắt lựa chọn đang bật, vd "Từng thẻ · Ngẫu nhiên · Kanji · Phần 2"
  const summary = document.querySelector<HTMLElement>("[data-display-summary]");
  const syncSummary = (): void => {
    if (!summary) return;
    const picked = ["view", "order", "focus", "part"]
      .map((name) => document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`))
      .filter((r): r is HTMLInputElement => !!r && r.id !== "part-all")
      .map((r) => (r.closest("label")?.textContent ?? "").trim().replace(/\s*\(\d+\)$/, ""));
    summary.textContent = picked.join(" · ");
  };
  syncSummary();
  document.getElementById("display-opts")?.addEventListener("change", syncSummary);

  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const stepLink = t.closest<HTMLAnchorElement>(".card-nav a[data-step]");
    if (stepLink) {
      e.preventDefault();
      step(Number(stepLink.dataset.step));
      return;
    }
    if (viewGrid?.checked && viewSingle) {
      const card = t.closest<HTMLElement>(".word-list .word-card");
      if (card && !t.closest("a, .tip")) {
        e.preventDefault(); // chặn label lật thẻ
        viewSingle.checked = true;
        syncSummary(); // đổi bằng code không phát sự kiện change
        go(card.id, true); // từ Lưới sang: cuộn tới thẻ một lần
      }
    }
  });
  // Đổi thứ tự (bật Ngẫu nhiên = xáo lại mỗi lần): sắp lại cả danh sách (lưới cũng đổi theo, bằng CSS order —
  // không di chuyển DOM) rồi về thẻ 1. Trước đây chỉ xáo ngầm và giữ thẻ đang xem → thẻ đó nhảy tới vị trí ngẫu nhiên.
  const reorder = (next: string[]): void => {
    order = next;
    order.forEach((id, i) => document.getElementById(id)?.style.setProperty("order", String(i)));
    const first = order[0];
    if (first) go(first);
  };
  random?.addEventListener("change", () => {
    if (random.checked) reorder(shuffle());
  });
  document.getElementById("order-seq")?.addEventListener("change", () => reorder(inPart()));
  // Đổi phần: ghi ?phan=N (bỏ #id cũ), sắp lại theo thứ tự đang chọn, về thẻ đầu của phần
  for (const r of partRadios) {
    r.addEventListener("change", () => {
      const u = new URL(location.href);
      const p = selectedPart();
      if (p) u.searchParams.set("phan", p);
      else u.searchParams.delete("phan");
      u.hash = "";
      history.replaceState(null, "", u);
      syncQuizLink();
      reorder(random?.checked ? shuffle() : inPart());
    });
  }
  // Nút Back/Forward của trình duyệt → hiện lại thẻ theo #id (không cuộn)
  window.addEventListener("popstate", () => show(fromHash() ?? order[0] ?? ""));
</script>
