---
// Nút Trước / Sau của chế độ "Từng thẻ" — link #id (CSS :target), chạy được cả khi tắt JS.
// Quay vòng trong bài: thẻ cuối → thẻ đầu, thẻ đầu → thẻ cuối.
// data-step: script ở LessonView dùng để đi theo thứ tự đang chọn (tuần tự / ngẫu nhiên).
// Chỉ hiện khi bật chế độ Từng thẻ (global.css .card-nav).
export interface NavLink {
  href: string;
  label: string;
}
interface Props {
  index: number; // 1-based
  total: number;
  prev: NavLink;
  next: NavLink;
}
const { index, total, prev, next } = Astro.props;
const btn =
  "inline-flex min-w-24 items-center justify-center gap-1 rounded-md border px-3 py-2 text-sm font-medium transition";
---

<nav class="card-nav mt-4 items-center justify-between gap-2 border-t border-line pt-3" aria-label="Chuyển thẻ">
  <a href={prev.href} data-step="-1" class:list={[btn, "border-line text-primary hover:bg-primary-soft"]} rel="prev">
    ← {prev.label}
  </a>
  <span class="card-pos text-xs text-ink-faint tabular-nums">{index} / {total}</span>
  <a
    href={next.href}
    data-step="1"
    class:list={[btn, "border-primary bg-primary text-surface hover:bg-primary-strong"]}
    rel="next"
  >
    {next.label} →
  </a>
</nav>
