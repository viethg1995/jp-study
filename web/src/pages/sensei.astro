---
// Landing page tri ân cô giáo dạy tiếng Nhật (Phạm Kiều Loan). Sensei đã đồng ý cho đăng tên, ảnh, link FB.
// Trang "cho vui": KHÔNG theo phong cách Nhật của site — màu riêng --color-fun-* (tokens.css).
// Bố cục lấy cảm hứng từ template portfolio (plan/refs, có license, KHÔNG commit) — code viết lại từ đầu.
// Mục "Chuyện lớp N4" là bản nháp vui do AI viết theo yêu cầu chủ site — sửa lại cho đúng kỷ niệm thật.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import avatar from "../assets/sensei/avatar.jpg";
import cover from "../assets/sensei/cover.jpg";
import nhaHang from "../assets/sensei/nha-hang.jpg";
import thoCam from "../assets/sensei/tho-cam.jpg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const FB = "https://www.facebook.com/xinhxinh.nhonho.1";
const MESSENGER = "https://m.me/xinhxinh.nhonho.1";

const INFO = [
  { icon: "🌼", title: "Quê hương", text: "Krông Năng, Đắk Lắk — THPT Nguyễn Huệ" },
  { icon: "🎓", title: "Học vấn", text: "ICLC Okinawa Japanese-language School" },
  { icon: "📚", title: "Lớp của tôi", text: "Tiếng Nhật N4 · từ tháng 5" },
];

const VIBES = [
  { icon: "🌻", label: "Hoa hướng dương" },
  { icon: "🌼", label: "Hoa dã quỳ" },
  { icon: "👗", label: "Áo dài" },
  { icon: "🧺", label: "Thổ cẩm & gùi" },
  { icon: "🏝️", label: "Biển Okinawa" },
  { icon: "🍜", label: "Đồ ăn Nhật" },
];

const ALBUM = [
  { img: cover, title: "Áo dài & hướng dương", tag: "Chân dung", alt: "Loan sensei mặc áo dài đỏ, cầm bó hoa hướng dương" },
  { img: thoCam, title: "Thổ cẩm Tây Nguyên", tag: "Quê nhà", alt: "Loan sensei mặc váy thổ cẩm, đeo gùi giữa vườn hoa dã quỳ" },
  { img: nhaHang, title: "いただきます！", tag: "Ở Nhật", alt: "Loan sensei giơ tay chữ V trong một nhà hàng ở Nhật" },
];

// Câu chuyện dạng tin nhắn
const CHAT: { who: "sensei" | "me" | "note"; text: string; vi?: string }[] = [
  { who: "note", text: "Buổi học đầu tiên · tháng 5" },
  { who: "me", text: "Trợ số từ thì có gì khó đâu cô, cứ số + 本 là xong 😎" },
  { who: "sensei", text: "えんぴつが三本あります。", vi: "Vậy câu này đọc sao em?" },
  { who: "me", text: "さんほん！" },
  { who: "sensei", text: "さんぼん nha 😂 Thế 六本 với 八本?" },
  { who: "me", text: "ろくほん… はちほん…? 🥲" },
  { who: "note", text: "Sai đủ cả ba kiểu ほん・ぼん・ぽん. Sensei phải dừng lại uống nước." },
  { who: "sensei", text: "大丈夫、やまない雨はないよ。", vi: "Sai bây giờ thì sau này sẽ đúng." },
];

const RING = "やまない雨はない ✿ ロアン先生 ✿ やまない雨はない ✿ ロアン先生 ✿ ";
---

<Base
  title="Loan sensei — cô giáo dạy tôi tiếng Nhật"
  description="Trang tri ân Phạm Kiều Loan (ロアン先生), cô giáo người Đắk Lắk đang sống ở Okinawa, đã dạy tôi tiếng Nhật N4. Sensei nhận dạy tiếng Nhật — liên hệ qua Facebook."
>
  <div class="el">
    <span class="haze haze-top" aria-hidden="true"></span>

    <!-- ========== HERO ========== -->
    <section class="hero">
      <Image src={avatar} alt="Ảnh chân dung Loan sensei" class="hero-ava" loading="eager" />
      <p class="hi serif">Xin chào! Đây là Kiều Loan <span class="wave" aria-hidden="true">👋</span></p>
      <h1 class="serif hero-title">
        Cô giáo tiếng Nhật đến từ <span class="grad">Đắk Lắk</span>, đang sống ở <span class="grad">Okinawa</span>.
      </h1>
      <p class="hero-desc">
        Phạm Kiều Loan — <span class="jp" lang="ja">ロアン先生</span> — người đã kiên nhẫn kéo một học trò hỏi nhiều như tôi đi qua từng bài N4.
      </p>
      <div class="hero-cta">
        <a href={MESSENGER} target="_blank" rel="noopener" class="pill pill-grad">Nhắn tin học với sensei <span aria-hidden="true">→</span></a>
        <a href={FB} target="_blank" rel="noopener" class="pill pill-line">Facebook <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- ========== GIỚI THIỆU ========== -->
    <section id="gioi-thieu" class="sec">
      <p class="eyebrow serif">Giới thiệu</p>
      <h2 class="sec-title serif">Về sensei</h2>

      <div class="about">
        <div class="about-photo">
          <Image src={thoCam} alt="Loan sensei mặc váy thổ cẩm, đeo gùi giữa vườn hoa dã quỳ" class="about-img" widths={[320, 540]} sizes="320px" />
          <div class="badge" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="badge-ring">
              <defs><path id="ring-path" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" /></defs>
              <text><textPath href="#ring-path" textLength="452">{RING}</textPath></text>
            </svg>
            <span class="badge-core">🌻</span>
          </div>
        </div>

        <div class="about-body">
          <p class="about-text">
            Chiều cao khiêm tốn, nội công thâm hậu: sức mạnh voi già Tây Nguyên 🐘, nụ cười hoa hướng dương 🌻, và một kho câu
            <span class="jp" lang="ja">やまない雨はない</span> cho mọi tình huống.
          </p>
          <ul class="info">
            {
              INFO.map((c) => (
                <li class="card">
                  <span class="card-icon" aria-hidden="true">{c.icon}</span>
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-text">{c.text}</p>
                </li>
              ))
            }
          </ul>
          <p class="vibes-title serif">Hình ảnh gắn với sensei</p>
          <ul class="vibes">
            {
              VIBES.map((v) => (
                <li class="vibe" title={v.label}>
                  <span aria-hidden="true">{v.icon}</span>
                  <span class="sr-only">{v.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ========== CHUYỆN LỚP N4 ========== -->
    <section id="ky-niem" class="sec">
      <p class="eyebrow serif">Kỷ niệm</p>
      <h2 class="sec-title serif">Chuyện lớp N4</h2>
      <p class="sec-desc">Buổi học đầu tiên, tôi tự tin hơi quá về trợ số từ…</p>

      <div class="chat">
        {
          CHAT.map((m) =>
            m.who === "note" ? (
              <p class="note">{m.text}</p>
            ) : (
              <div class={`msg ${m.who}`}>
                {m.who === "sensei" && <Image src={avatar} alt="" class="msg-ava" width={40} height={40} />}
                <div class="bubble">
                  <span class="jp-mix">{m.text}</span>
                  {m.vi && <span class="bubble-vi">{m.vi}</span>}
                </div>
              </div>
            ),
          )
        }
      </div>
      <p class="story-end">
        Về nhà tôi lập hẳn một bảng biến âm để tự kiểm tra. Bảng đó lớn dần, rồi thành trang
        <a href={`${base}/dem-so/bien-am/`}>Biến âm</a> trên chính website này. Nên nếu bạn thấy phần
        <a href={`${base}/dem-so/`}>Đếm số</a> ở đây kỹ quá mức cần thiết — đó là lỗi của sensei 😄
      </p>
    </section>

    <!-- ========== ALBUM ========== -->
    <section id="album" class="sec">
      <p class="eyebrow serif">Album</p>
      <h2 class="sec-title serif">Khoảnh khắc</h2>
      <p class="sec-desc">Hai miền, một người: Tây Nguyên quê nhà và nước Nhật bây giờ.</p>

      <div class="album">
        {
          ALBUM.map((a) => (
            <a href={FB} target="_blank" rel="noopener" class="shot">
              <Image src={a.img} alt={a.alt} class="shot-img" widths={[320, 640]} sizes="(min-width: 768px) 320px, 90vw" />
              <span class="shot-label">
                <span>
                  <span class="shot-title">{a.title}</span>
                  <span class="shot-tag">{a.tag}</span>
                </span>
                <span class="shot-go" aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ========== QUOTE ========== -->
    <section class="sec quote">
      <p class="quote-jp jp" lang="ja">やまない雨はないよ。</p>
      <p class="quote-vi serif">“Không có cơn mưa nào mà không tạnh.”</p>
      <p class="quote-2 serif">“Hiện tại là tất cả những gì chúng ta đang có.”</p>
      <p class="quote-by">— hai câu sensei yêu thích</p>
    </section>

    <!-- ========== LIÊN HỆ ========== -->
    <section id="lien-he" class="sec contact">
      <span class="haze haze-bottom" aria-hidden="true"></span>
      <p class="eyebrow serif">Kết nối</p>
      <h2 class="sec-title serif">Học cùng sensei</h2>
      <p class="sec-desc">Sensei đang nhận dạy. Nhắn tin để hỏi lịch học và trình độ phù hợp nhé!</p>

      <div class="contact-card">
        <a href={MESSENGER} target="_blank" rel="noopener" class="pill pill-dark">💬 Nhắn tin qua Messenger <span aria-hidden="true">→</span></a>
        <a href={FB} target="_blank" rel="noopener" class="pill pill-line">Xem Facebook của sensei <span aria-hidden="true">↗</span></a>
      </div>

      <p class="quick-title">Hoặc ôn bài N4 ngay trên site</p>
      <ul class="quick">
        <li><a href={`${base}/vocabulary/n4/`}><span class="jp" aria-hidden="true">語</span> Từ vựng N4</a></li>
        <li><a href={`${base}/kanji/n4/`}><span class="jp" aria-hidden="true">字</span> Kanji N4</a></li>
        <li><a href={`${base}/chia-the/`}><span class="jp" aria-hidden="true">活</span> Chia thể</a></li>
        <li><a href={`${base}/dem-so/`}><span class="jp" aria-hidden="true">数</span> Đếm số</a></li>
      </ul>

      <p class="thanks serif">
        Cảm ơn sensei đã kiên nhẫn với một học trò hỏi nhiều. <span class="jp" lang="ja">先生、ありがとうございます！</span> 💐
      </p>
    </section>
  </div>
</Base>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap&subset=vietnamese");

  .el {
    --ink: var(--color-fun-ink);
    --ink-2: color-mix(in srgb, var(--color-fun-ink) 72%, transparent);
    --line: color-mix(in srgb, var(--color-fun-ink) 18%, transparent);
    --grad: linear-gradient(90deg, var(--color-fun-plum), var(--color-fun-amber));
    position: relative;
    isolation: isolate;
    color: var(--ink);
    font-family: "Be Vietnam Pro", var(--font-sans);
    line-height: 1.75;
    padding-bottom: 2rem;
  }
  .serif {
    font-family: "Playfair Display", Georgia, serif;
  }
  .jp,
  .jp-mix {
    font-family: "Be Vietnam Pro", var(--font-jp);
  }

  /* Nền mờ pastel (vàng → hồng → tím → xanh) */
  .haze {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    filter: blur(60px);
    opacity: 0.9;
  }
  .haze-top {
    top: -6rem;
    right: -4rem;
    width: min(90vw, 760px);
    height: 520px;
    background:
      radial-gradient(closest-side at 18% 62%, var(--color-fun-sun-soft), transparent),
      radial-gradient(closest-side at 42% 55%, var(--color-fun-pink-soft), transparent),
      radial-gradient(closest-side at 64% 50%, var(--color-fun-violet-soft), transparent),
      radial-gradient(closest-side at 84% 40%, var(--color-fun-sky-soft), transparent);
  }
  .haze-bottom {
    inset: 10% 5% 0;
    background:
      radial-gradient(closest-side at 25% 50%, var(--color-fun-sun-soft), transparent),
      radial-gradient(closest-side at 50% 55%, var(--color-fun-pink-soft), transparent),
      radial-gradient(closest-side at 75% 45%, var(--color-fun-violet-soft), transparent);
  }

  /* ---------- HERO ---------- */
  .hero {
    min-height: calc(100svh - 6rem);
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem 0 3rem;
  }
  .hero :global(.hero-ava) {
    width: 8rem;
    height: 8rem;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 0 0 4px var(--color-surface), 0 0 0 6px var(--color-fun-pink);
  }
  .hi {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
  }
  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.4s ease-in-out infinite;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(14deg); }
    20%, 40% { transform: rotate(-8deg); }
  }
  .hero-title {
    font-size: clamp(2rem, 6.5vw, 4rem);
    line-height: 1.15;
    font-weight: 500;
  }
  .grad {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }
  .hero-desc {
    max-width: 38rem;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .hero-cta {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 2rem;
    border-radius: 9999px;
    font-weight: 500;
    transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .pill:hover {
    transform: translateY(-2px);
  }
  .pill-grad {
    background: var(--grad);
    color: var(--color-surface);
  }
  .pill-grad:hover {
    box-shadow: 0 8px 24px var(--color-fun-glow);
  }
  .pill-line {
    border: 1px solid var(--line);
    background: var(--color-surface);
    color: var(--ink);
  }
  .pill-line:hover {
    background: var(--color-fun-violet-soft);
  }
  .pill-dark {
    background: var(--ink);
    color: var(--color-surface);
  }
  .pill-dark:hover {
    box-shadow: 4px 4px 0 var(--color-fun-pink);
  }

  /* ---------- SECTION ---------- */
  .sec {
    position: relative;
    padding: 4rem 0;
    scroll-margin-top: 4rem;
  }
  .eyebrow {
    text-align: center;
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .sec-title {
    text-align: center;
    font-size: clamp(2.25rem, 6vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }
  .sec-desc {
    max-width: 40rem;
    margin: 1rem auto 0;
    text-align: center;
    color: var(--ink-2);
  }

  /* ---------- ABOUT ---------- */
  .about {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.5rem;
  }
  @media (min-width: 1024px) {
    .about { flex-direction: row; align-items: center; gap: 5rem; }
  }
  .about-photo {
    position: relative;
    flex-shrink: 0;
  }
  .about-photo :global(.about-img) {
    width: min(72vw, 20rem);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.5rem;
  }
  .badge {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 50%;
    aspect-ratio: 1;
    transform: translate(25%, 33%);
    display: grid;
    place-items: center;
    border-radius: 9999px;
    background: var(--color-surface);
    box-shadow: 0 4px 55px var(--color-fun-glow);
  }
  .badge-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 14s linear infinite;
  }
  .badge-ring text {
    font-family: "Be Vietnam Pro", var(--font-jp);
    font-size: 15px;
    fill: var(--ink);
    letter-spacing: 1px;
  }
  .badge-core {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .about-body { flex: 1; }
  .about-text {
    max-width: 42rem;
    font-size: 1.05rem;
  }
  .info {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) { .info { grid-template-columns: repeat(3, 1fr); } }
  .card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--color-surface);
    transition: transform 0.5s, box-shadow 0.5s, background 0.5s;
  }
  .card:hover {
    transform: translateY(-4px);
    background: var(--color-fun-violet-soft);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .card-icon { font-size: 1.6rem; }
  .card-title { margin-top: 0.75rem; font-weight: 600; }
  .card-text { margin-top: 0.25rem; font-size: 0.9rem; line-height: 1.55; color: var(--ink-2); }
  .vibes-title { margin-top: 2rem; color: var(--ink-2); }
  .vibes {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .vibe {
    display: grid;
    place-items: center;
    width: 3.25rem;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    font-size: 1.5rem;
    background: var(--color-surface);
    transition: transform 0.5s;
  }
  .vibe:hover { transform: translateY(-4px); }

  /* ---------- CHAT ---------- */
  .chat {
    max-width: 40rem;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--color-surface);
    box-shadow: 0 10px 40px var(--color-fun-glow);
  }
  @media (min-width: 640px) { .chat { padding: 2rem; } }
  .note {
    align-self: center;
    padding: 0.2rem 0.9rem;
    border-radius: 9999px;
    background: var(--color-fun-sun-soft);
    font-size: 0.8rem;
    text-align: center;
  }
  .msg { display: flex; align-items: flex-end; gap: 0.5rem; max-width: 85%; }
  .msg.me { align-self: flex-end; }
  .msg :global(.msg-ava) { width: 36px; height: 36px; border-radius: 9999px; object-fit: cover; flex-shrink: 0; }
  .bubble {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 1rem;
    border-radius: 1.25rem;
    line-height: 1.5;
  }
  .sensei .bubble { background: var(--color-fun-violet-soft); border-bottom-left-radius: 0.3rem; }
  .me .bubble { background: var(--grad); color: var(--color-surface); border-bottom-right-radius: 0.3rem; }
  .bubble-vi { font-size: 0.85rem; color: var(--ink-2); }
  .story-end {
    max-width: 40rem;
    margin: 1.5rem auto 0;
    color: var(--ink-2);
  }
  .story-end a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-fun-plum);
    text-underline-offset: 4px;
  }

  /* ---------- ALBUM ---------- */
  .album {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .shot {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .shot :global(.shot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .shot:hover :global(.shot-img) { transform: scale(1.05); }
  .shot-label {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 84%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    transition: bottom 0.5s;
  }
  .shot:hover .shot-label { bottom: 1.75rem; }
