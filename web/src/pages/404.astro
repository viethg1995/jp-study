---
// GitHub Pages trả file 404.html cho mọi đường dẫn không tồn tại.
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/vocabulary/`, label: "Từ vựng" },
  { href: `${base}/kanji/`, label: "Kanji" },
  { href: `${base}/chia-the/`, label: "Chia thể" },
  { href: `${base}/dem-so/`, label: "Đếm số" },
];
---

<Base title="Không tìm thấy trang" noindex>
  <section class="py-16 text-center">
    <p class="jp text-6xl font-bold text-ink-faint" lang="ja">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink">Không tìm thấy trang</h1>
    <p class="mt-2 text-ink-muted">Đường dẫn có thể đã đổi. Thử về trang chủ hoặc một mục bên dưới.</p>
    <nav class="mt-6 flex flex-wrap justify-center gap-2">
      <a href={`${base}/`} class="rounded-md border border-line bg-surface px-3 py-1.5 text-primary hover:bg-primary-soft">Trang chủ</a>
      {
        links.map((l) => (
          <a href={l.href} class="rounded-md border border-line bg-surface px-3 py-1.5 text-primary hover:bg-primary-soft">
            {l.label}
          </a>
        ))
      }
    </nav>
  </section>
</Base>
