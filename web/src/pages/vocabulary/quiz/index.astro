---
// Quiz từ vựng (Q4): chọn cấp → khoảng bài → loại câu (chọn nhiều). Câu hỏi sinh lúc build thành file
// /vocabulary/quiz/<cấp>-<loại>-<bài đầu>.json (lib/quiz/vocab.ts, chia chunk lib/quiz/chunks.ts), trang chỉ tải chunk của loại câu + khoảng bài đang chọn.
// Bộ lọc ghi lên URL (D6): ?cap=n5&tu=1&den=10&loai=doc,nghia — không localStorage.
// Học theo phần: chọn đúng 1 bài có ≥ 2 phần → dòng "Phần" (?phan=N, lọc tag part = "<bài>-<phần>", lib/vocab-parts.ts).
import { getCollection } from "astro:content";
import QuizRunner from "../../../components/quiz/QuizRunner.astro";
import Segmented from "../../../components/ui/Segmented.astro";
import Base from "../../../layouts/Base.astro";
import type { ParamDef } from "../../../lib/quiz/params";
import { LEVEL_LESSONS, VOCAB_KIND_LABEL, VOCAB_KINDS, VOCAB_LEVELS, type VocabKindSlug, levelOf } from "../../../lib/quiz/vocab";
import { partCount } from "../../../lib/vocab-parts";

// Số phần mỗi bài theo cấp: { n5: { "1": 3, … } } — trang ẩn dòng "Phần" khi bài chỉ có 1 phần
const partsByLevel: Record<string, Record<string, number>> = {};
for (const l of [...(await getCollection("vocabulary")), ...(await getCollection("vocabularyN3"))]) {
  const first = l.data.entries[0];
  if (!first) continue;
  (partsByLevel[levelOf(first)] ??= {})[String(l.data.lesson)] = partCount(l.data.entries.length);
}
const MAX_PARTS = 3;

const slugs = Object.keys(VOCAB_KINDS) as VocabKindSlug[];
const params: ParamDef[] = [
  { param: "cap", tag: "level", type: "enum", options: Object.fromEntries(VOCAB_LEVELS.map((l) => [l, l])) },
  { param: "tu", tag: "lesson", type: "min", lo: 1, hi: 50 },
  { param: "den", tag: "lesson", type: "max", lo: 1, hi: 50 },
  { param: "loai", tag: "kind", type: "enum", options: { ...VOCAB_KINDS }, multi: true },
];
const KIND_HINT: Record<VocabKindSlug, string> = {
  doc: "先生 → せんせい",
  nghia: "先生 → giáo viên",
  tu: "giáo viên → 先生",
  hv: "学生 → HỌC SINH",
  dien: "điền từ vào câu ví dụ",
};
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLink = "rounded px-2 py-1 text-primary hover:bg-primary-soft";
const select = "rounded-md border border-line bg-surface px-2 py-1 text-ink";
// Chọn nhiều: nền nhạt + ✓ (khác hẳn nút chọn một — nền đặc — của Cấp / Số câu)
const chip =
  "group relative inline-flex cursor-pointer items-center gap-1 rounded-full border border-line bg-surface px-3 py-1 whitespace-nowrap text-ink hover:border-primary-line has-checked:border-primary has-checked:bg-primary-soft has-checked:font-semibold has-checked:text-primary has-focus-visible:outline-2 has-focus-visible:outline-primary";
const kindLabels = Object.fromEntries(slugs.map((s) => [VOCAB_KINDS[s], VOCAB_KIND_LABEL[s]]));
---

<Base title="Luyện tập từ vựng" description="Luyện từ vựng みんなの日本語 N5–N4 và N3: cách đọc, nghĩa, âm Hán-Việt, điền từ vào câu — chọn theo bài.">
  <nav slot="header" class="ml-auto flex items-center gap-2 text-sm">
    <a href={`${base}/vocabulary/`} class={navLink}>Từ vựng</a>
  </nav>

  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold">Luyện tập từ vựng</h1>

    <div class="mt-4">
      <QuizRunner question="Chọn đáp án đúng" kindLabels={kindLabels} balanceKinds furiganaToggle typing>
        <Fragment slot="filters">
          <Segmented name="q-level" label="Cấp" options={VOCAB_LEVELS.map((l) => ({ id: `cap-${l}`, label: LEVEL_LESSONS[l].label }))} checked="cap-n5" />
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <label for="q-from" class="seg-label shrink-0">Bài:</label>
            <div class="flex items-center gap-2">
              <select id="q-from" class={select} aria-label="Từ bài"></select>
              <span>–</span>
              <select id="q-to" class={select} aria-label="Đến bài"></select>
            </div>
          </div>
          <div id="q-part-row" hidden>
            <Segmented
              name="q-part"
              label="Phần"
              checked="q-part-all"
              options={[{ id: "q-part-all", label: "Tất cả" }, ...Array.from({ length: MAX_PARTS }, (_, i) => ({ id: `q-part-${i + 1}`, label: `Phần ${i + 1}` }))]}
            />
          </div>
          <div class="flex items-baseline gap-3" role="group" aria-label="Loại câu (chọn nhiều để trộn)">
            <span class="seg-label shrink-0">Loại câu:</span>
            <div>
              <div class="flex flex-wrap gap-1.5">
                {
                  slugs.map((s) => (
                    <label class={chip} title={KIND_HINT[s]}>
                      <input type="checkbox" name="q-kind" value={s} id={`loai-${s}`} class="sr-only" checked={s === "nghia"} />
                      <span class="hidden group-has-[:checked]:inline" aria-hidden="true">✓</span>
                      {VOCAB_KIND_LABEL[s]}
                    </label>
                  ))
                }
              </div>
              <p class="mt-1.5 text-xs text-ink-faint">Chọn nhiều để trộn — mỗi lượt chia đều số câu cho các loại.</p>
            </div>
          </div>
        </Fragment>
      </QuizRunner>
    </div>
  </div>

  <script type="application/json" id="q-config" set:html={JSON.stringify({ params, levels: LEVEL_LESSONS, kinds: VOCAB_KINDS, parts: partsByLevel })} />
</Base>

<script>
  import { readFilter, writeFilter, type ParamDef } from "../../../lib/quiz/params";
  import { chunkPaths } from "../../../lib/quiz/chunks";
  import { mountQuiz } from "../../../lib/quiz/runner";
  import type { Filter } from "../../../lib/quiz/types";

  type Level = "n5" | "n4" | "n3";
  const cfg = JSON.parse(document.getElementById("q-config")!.textContent ?? "{}") as {
    params: ParamDef[];
    levels: Record<Level, { from: number; to: number; label: string }>;
    kinds: Record<string, string>;
    parts: Record<string, Record<string, number>>;
  };
  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  const fromSel = document.getElementById("q-from") as HTMLSelectElement;
  const toSel = document.getElementById("q-to") as HTMLSelectElement;
  const kindBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="q-kind"]')];
  const kindSlug = Object.fromEntries(Object.entries(cfg.kinds).map(([slug, kind]) => [kind, slug]));

  const level = (): Level => (document.querySelector<HTMLInputElement>('input[name="q-level"]:checked')?.id.replace("cap-", "") ?? "n5") as Level;

  /** Điền danh sách bài theo cấp; giữ giá trị nếu còn nằm trong khoảng, không thì về cả cấp. */
  function fillLessons(from?: number, to?: number): void {
    const r = cfg.levels[level()];
    const inRange = (n: number | undefined): n is number => n !== undefined && n >= r.from && n <= r.to;
    for (const sel of [fromSel, toSel]) {
      sel.replaceChildren(
        ...Array.from({ length: r.to - r.from + 1 }, (_, i) => {
          const o = document.createElement("option");
          o.value = o.textContent = String(r.from + i);
          return o;
        }),
      );
    }
    fromSel.value = String(inRange(from) ? from : r.from);
    toSel.value = String(inRange(to) ? to : r.to);
  }

  // Dòng "Phần": chỉ hiện khi Từ bài = Đến bài và bài đó có ≥ 2 phần; ẩn nút Phần vượt số phần của bài
  const partRow = document.getElementById("q-part-row") as HTMLElement;
  const partRadios = [...document.querySelectorAll<HTMLInputElement>('input[name="q-part"]')];
  const partAll = document.getElementById("q-part-all") as HTMLInputElement;
  const partsOfLesson = (): number =>
    fromSel.value === toSel.value ? (cfg.parts[level()]?.[fromSel.value] ?? 1) : 1;
  const selectedPart = (): number | null => {
    const r = partRadios.find((x) => x.checked);
    return !partRow.hidden && r && r !== partAll ? Number(r.id.slice("q-part-".length)) : null;
  };
  function updatePartRow(): void {
    const k = partsOfLesson();
    partRow.hidden = k < 2;
    for (const r of partRadios) {
      if (r === partAll) continue;
      const n = Number(r.id.slice("q-part-".length));
      (r.closest("label") as HTMLElement).hidden = n > k;
      if (n > k && r.checked) partAll.checked = true;
    }
  }

  // URL → điều khiển
  const fromUrl = readFilter(location.search, cfg.params);
  const urlLevel = Array.isArray(fromUrl.level) ? (String(fromUrl.level[0]) as Level) : "n5";
  (document.getElementById(`cap-${urlLevel}`) as HTMLInputElement).checked = true;
  const lesson = fromUrl.lesson && !Array.isArray(fromUrl.lesson) ? (fromUrl.lesson as { min?: number; max?: number }) : {};
  fillLessons(lesson.min, lesson.max);
  if (Array.isArray(fromUrl.kind)) {
    const want = new Set(fromUrl.kind.map((k) => kindSlug[String(k)]));
    for (const b of kindBoxes) b.checked = want.has(b.value);
  }
  const urlPart = document.getElementById(`q-part-${new URLSearchParams(location.search).get("phan") ?? ""}`) as HTMLInputElement | null;
  if (urlPart && partRadios.includes(urlPart)) urlPart.checked = true;
  updatePartRow();

  // Điều khiển → bộ lọc, file Deck, URL
  const quiz = mountQuiz(document.querySelector<HTMLElement>("[data-quiz]")!);
  function apply(): void {
    const lv = level();
    let from = Number(fromSel.value), to = Number(toSel.value);
    if (from > to) [from, to] = [to, from];
    const slugs = kindBoxes.filter((b) => b.checked).map((b) => b.value);
    const kinds = slugs.map((s) => cfg.kinds[s]!);
    const filter: Filter = { lesson: { min: from, max: to }, kind: kinds };
    const part = selectedPart();
    if (part !== null) filter.part = [`${from}-${part}`];
    const qs = writeFilter({ level: [lv], lesson: { min: from, max: to }, kind: kinds }, cfg.params);
    history.replaceState(null, "", `?${qs}${part !== null ? `&phan=${part}` : ""}`);
    // chỉ tải chunk (nhóm bài, Q12) giao với khoảng bài đang chọn
    quiz.setFilter(filter, slugs.flatMap((s) => chunkPaths("vocabulary/quiz", `${lv}-${s}`, lv, cfg.levels[lv], from, to).map((p) => base + p)));
  }
  for (const r of document.querySelectorAll<HTMLInputElement>('input[name="q-level"]')) {
    r.addEventListener("change", () => {
      fillLessons();
      lessonChanged();
    });
  }
  // Đổi cấp / bài → phần về "Tất cả" (phần 2 của bài khác là nhóm từ khác)
  function lessonChanged(): void {
    partAll.checked = true;
    updatePartRow();
    apply();
  }
  fromSel.addEventListener("change", () => {
    if (Number(fromSel.value) > Number(toSel.value)) toSel.value = fromSel.value;
    lessonChanged();
  });
  toSel.addEventListener("change", () => {
    if (Number(toSel.value) < Number(fromSel.value)) fromSel.value = toSel.value;
    lessonChanged();
  });
  for (const b of kindBoxes) b.addEventListener("change", apply);
  for (const r of partRadios) r.addEventListener("change", apply);
  apply();
</script>
