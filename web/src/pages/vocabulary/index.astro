---
// Tổng quan Từ vựng: 3 thẻ cấp độ → mỗi cấp một trang riêng (/vocabulary/n5/, /n4/, /n3/).
// Không liệt kê bài ở đây để trang nhẹ, menu con mở thẳng trang cấp độ (không phải neo #… trên trang dài).
import { getCollection } from "astro:content";
import LevelTabs from "../../components/ui/LevelTabs.astro";
import Base from "../../layouts/Base.astro";
import { levelTabs, type Level } from "../../lib/levels";

const lessons = (await getCollection("vocabulary")).map((l) => l.data);
const n3 = (await getCollection("vocabularyN3")).map((l) => l.data);
const words = (xs: { entries: unknown[] }[]): number => xs.reduce((n, l) => n + l.entries.length, 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const n5 = lessons.filter((l) => l.lesson <= 25);
const n4 = lessons.filter((l) => l.lesson > 25);
const cards: { level: Level; title: string; subtitle: string; lessons: number; words: number }[] = [
  { level: "n5", title: "N5", subtitle: "みんなの日本語 · Bài 1–25", lessons: n5.length, words: words(n5) },
  { level: "n4", title: "N4", subtitle: "みんなの日本語 · Bài 26–50", lessons: n4.length, words: words(n4) },
  { level: "n3", title: "N3", subtitle: "N3 準備 文字語彙", lessons: n3.length, words: words(n3) },
];
const total = cards.reduce((n, c) => n + c.words, 0);
---

<Base title="Từ vựng" description="Từ vựng tiếng Nhật theo bài みんなの日本語 (50 bài N5–N4) và N3: nghĩa tiếng Việt, âm Hán-Việt, furigana, câu ví dụ, chế độ thẻ ghi nhớ.">
  <LevelTabs label="Cấp độ" tabs={levelTabs(base, "vocabulary", null)} />

  <h1 class="text-2xl font-bold">Từ vựng</h1>
  <p class="mt-1 text-sm text-ink-muted">N5 – N3 · {total} từ</p>

  <ul class="mt-6 grid gap-3 sm:grid-cols-3">
    {
      cards.map((c) => (
        <li>
          <a
            href={`${base}/vocabulary/${c.level}/`}
            class="flex h-full flex-col gap-1 rounded-lg border border-line bg-surface p-4 transition hover:border-primary"
          >
            <span class="text-xl font-bold text-ink">{c.title}</span>
            <span class="text-sm text-ink-muted">{c.subtitle}</span>
            <span class="mt-auto pt-2 text-xs text-ink-faint">
              {c.lessons} bài · {c.words} từ
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
