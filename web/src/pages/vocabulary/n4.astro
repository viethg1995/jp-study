---
// Từ vựng N4: Minna bài 26–50.
import { getCollection } from "astro:content";
import LevelPage from "../../components/vocab/LevelPage.astro";

const lessons = (await getCollection("vocabulary"))
  .map((l) => l.data)
  .filter((l) => l.lesson > 25)
  .sort((a, b) => a.lesson - b.lesson)
  .map((l) => ({ lesson: l.lesson, count: l.entries.length }));
---

<LevelPage level="n4" subtitle="みんなの日本語 · Bài 26–50" route="vocabulary" lessons={lessons} />
