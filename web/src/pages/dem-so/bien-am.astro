---
// Biến âm — mỗi tab một nhóm âm đầu: một dòng công thức + bảng mẫu (hàng = số 1–10, cột = trợ số từ; chỉ ô biến âm được tô).
// Giải thích dài nằm trong <details>, mặc định đóng. Tab bằng radio + CSS :has(), không cần JS.
import { getCollection } from "astro:content";
import Segmented from "../../components/ui/Segmented.astro";
import type { Counter, SoundGroup } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { counterPath, isChanged, readingOf } from "../../lib/counters";

const counters = (await getCollection("counterItems")).map((c) => c.data).sort((a, b) => a.order - b.order);
const rules = new Map((await getCollection("soundRules")).map((r) => [r.data.group, r.data]));

const KEY = new Set([1, 3, 6, 8, 10, 100]); // hàng hay biến âm
const NUMS = Array.from({ length: 10 }, (_, i) => i + 1);
const ROWS = [...NUMS, 100]; // 100 ひゃく cũng biến âm (ひゃっぽん, ひゃっかい) — công thức nhóm h/k có nhắc
// 7 nhóm dữ liệu gộp thành 5 tab
const TABS: { id: string; label: string; groups: SoundGroup[] }[] = [
  { id: "h", label: "は h", groups: ["h"] },
  { id: "k", label: "か k", groups: ["k"] },
  { id: "st", label: "さ・た", groups: ["s", "t"] },
  { id: "none", label: "Không đổi", groups: ["none"] },
  { id: "own", label: "Đọc riêng", groups: ["native", "special"] },
];
const panels = TABS.map((t) => ({
  ...t,
  blocks: t.groups.flatMap((g) => {
    const rule = rules.get(g);
    const items = counters.filter((c) => c.sound_group === g);
    if (!rule || !items.length) return [];
    const changed = (c: Counter, n: number): boolean => {
      const r = readingOf(c, n);
      return r ? isChanged(c, r) : false;
    };
    // Nhóm không biến âm: tách trợ số từ ghép thẳng hoàn toàn (không cần bảng) khỏi trợ số từ có ngoại lệ;
    // bảng chỉ giữ các hàng có ngoại lệ.
    const plain = g === "none" ? items.filter((c) => !NUMS.some((n) => changed(c, n))) : [];
    const table = items.filter((c) => !plain.includes(c));
    // Hàng 100 chỉ hiện khi có ô biến âm (nhóm s/t không đổi ở 100)
    const rows = ROWS.filter((n) => (g === "none" || n === 100 ? table.some((c) => changed(c, n)) : true));
    return [{ rule, plain, table, rows }];
  }),
})).filter((p) => p.blocks.length > 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLink = "rounded px-2 py-1 text-primary hover:bg-primary-soft";
---

<Base title="Biến âm" description="Quy tắc biến âm khi ghép số với trợ số từ trong tiếng Nhật (âm ngắt っ, chuyển h → p/b…), tóm tắt theo nhóm kèm ví dụ.">
  <nav slot="header" class="ml-auto flex items-center gap-2 text-sm">
    <a href={`${base}/dem-so/`} class={navLink}>← Đếm số</a>
  </nav>

  <div class="mx-auto max-w-4xl">
    <h1 class="text-2xl font-bold">Biến âm</h1>
    <p class="mt-1 text-ink-muted">
      Thường chỉ <b class="font-semibold text-ink">1, 3, 6, 8, 10</b> đổi âm. Âm đầu của trợ số từ quyết định đổi thế nào.
    </p>

    <div class="mt-5 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink-muted">
      <Segmented name="sgroup" label="Nhóm" checked="sg-h" options={panels.map((p) => ({ id: `sg-${p.id}`, label: p.label }))} wrap />
    </div>

    {
      panels.map((p) => (
        <section class={`sg-panel sg-panel-${p.id} mt-6 flex flex-col gap-8`} aria-label={p.label}>
          {p.blocks.map(({ rule, plain, table, rows }) => (
            <div>
              <div class="flex flex-col gap-1 text-lg font-semibold text-ink">
                {rule.summary_vi.split(" · ").map((l) => <p>{l}</p>)}
              </div>

              {plain.length > 0 && (
                <div class="mt-4 rounded-lg border border-line bg-surface px-5 py-4">
                  <p class="text-[15px] font-semibold text-ink">Ghép thẳng, không có ngoại lệ</p>
                  <p class="mt-2 flex flex-wrap gap-1.5">
                    {plain.map((c) => (
                      <a href={`${base}/${counterPath(c)}`} class="jp rounded border border-line px-2.5 py-0.5 text-base font-bold text-ink hover:border-primary-line hover:text-primary" lang="ja">
                        {c.char}
                      </a>
                    ))}
                  </p>
                  <p class="jp mt-2 text-sm text-ink-muted" lang="ja">
                    {NUMS.map((n) => readingOf(plain[0]!, n)?.kana).filter(Boolean).join("・")}
                  </p>
                </div>
              )}

              {table.length > 0 && (
                <>
                  {plain.length > 0 && (
                    <p class="mt-6 text-[15px] font-semibold text-ink">
                      Có cách đọc riêng <span class="font-normal text-ink-muted">— chỉ hiện các số có ngoại lệ, số khác ghép thẳng</span>
                    </p>
                  )}
                  {/* Hàng = số, cột = trợ số từ */}
                  <div class:list={["relative overflow-x-auto rounded-lg border border-line bg-surface", plain.length > 0 ? "mt-2" : "mt-4"]}>
                    <table class="w-full text-sm">
                      <thead>
                        <tr class="border-b border-line">
                          <th class="w-8" />
                          {table.map((c) => (
                            <th class="px-1 py-2">
                              <a href={`${base}/${counterPath(c)}`} class="jp text-base font-bold text-ink underline decoration-line-strong decoration-dotted underline-offset-4 hover:text-primary hover:decoration-primary" lang="ja">{c.char}</a>
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {rows.map((n) => (
                          <tr class="border-b border-line last:border-b-0">
                            <th class:list={["px-2 py-1.5 text-right font-medium tabular-nums", KEY.has(n) || rule.group === "none" ? "text-ink" : "text-ink-faint"]}>{n}</th>
                            {table.map((c) => {
                              const r = readingOf(c, n);
                              const hot = r ? isChanged(c, r) : false;
                              return (
                                <td class:list={["jp px-1 py-1.5 text-center whitespace-nowrap", hot ? "font-semibold text-primary" : "text-ink-faint"]} lang="ja">
                                  {r?.kana ?? ""}
                                </td>
                              );
                            })}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </>
              )}

              <details class="mt-3 text-[15px]">
                <summary class="cursor-pointer text-primary">Giải thích</summary>
                <ul class="mt-2 flex flex-col gap-1.5 leading-relaxed text-ink">
                  {rule.rule_vi.map((l) => (
                    <li class="flex gap-2">
                      <span class="text-ink-faint">•</span>
                      <span>{l}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </div>
          ))}
        </section>
      ))
    }

    <p class="mt-8 text-sm text-ink-faint">Chữ xanh: cách đọc khác với "số + trợ số từ" ghép thẳng. Bấm vào trợ số từ để xem đủ bảng và ví dụ.</p>
  </div>
</Base>

<style is:global>
  .sg-panel {
    display: none;
  }
  body:has(#sg-h:checked) .sg-panel-h,
  body:has(#sg-k:checked) .sg-panel-k,
  body:has(#sg-st:checked) .sg-panel-st,
  body:has(#sg-none:checked) .sg-panel-none,
  body:has(#sg-own:checked) .sg-panel-own {
    display: flex;
  }
</style>
