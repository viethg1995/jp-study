---
// Quiz đếm số, 2 loại câu (chọn một): "Đếm đồ vật" = số + trợ số từ (n-ctr, lib/counter-quiz.ts) và "Số" = số đếm
// (n-num, Q7 plan/quiz/q07-numbers.md, lib/quiz/numbers.ts); chọn 1 trong 4 cách đọc. Câu hỏi + nhiễu sinh lúc build,
// nhúng HTML. Khung quiz: components/quiz/QuizRunner.astro.
// Lọc ghi lên URL, không localStorage: đồ vật ?tro=hon&nhom=h&o=tat-ca · số ?loai=so&nhom-so=tram-nghin.
import { getCollection, getEntry } from "astro:content";
import QuizRunner from "../../components/quiz/QuizRunner.astro";
import Combobox from "../../components/ui/Combobox.astro";
import Segmented from "../../components/ui/Segmented.astro";
import type { SoundGroup } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { buildQuizItems, toQuizItems } from "../../lib/counter-quiz";
import { DISPLAY_GROUPS, counterSlug } from "../../lib/counters";
import { NUM_TAB_SLUG, numberItems } from "../../lib/quiz/numbers";
import type { ParamDef } from "../../lib/quiz/params";

const counters = (await getCollection("counterItems")).map((c) => c.data).sort((a, b) => a.order - b.order);
const ctrItems = toQuizItems(buildQuizItems(counters));
const numbers = (await getEntry("numbers", "numbers"))?.data;
if (!numbers) throw new Error("thiếu numbers trong data/counters.json");
const numItems = numberItems(numbers);
const items = [...ctrItems, ...numItems];
const numTabs = [{ id: "t-all", label: `Tất cả (${numItems.length})` }, ...numbers.tabs.map((t) => ({ id: `t-${t.id}`, label: t.label }))];

// Nhóm âm gộp như trang Biến âm; `slug` là giá trị trên URL
const GROUPS: { id: string; slug: string; label: string; groups: SoundGroup[] }[] = [
  { id: "g-all", slug: "", label: "Tất cả", groups: [] },
  { id: "g-h", slug: "h", label: "は h", groups: ["h"] },
  { id: "g-k", slug: "k", label: "か k", groups: ["k"] },
  { id: "g-st", slug: "st", label: "さ・た", groups: ["s", "t"] },
  { id: "g-none", slug: "khong-doi", label: "Không đổi", groups: ["none"] },
  { id: "g-own", slug: "rieng", label: "Đọc riêng", groups: ["native", "special"] },
];
const groupMap = Object.fromEntries(GROUPS.map((g) => [g.id, g.groups]));
const counterGroups = [
  { title: null, options: [{ value: "", label: "Tất cả trợ số từ" }] },
  ...DISPLAY_GROUPS.map((g) => ({
    title: g.label,
    options: counters
      .filter((c) => g.cats.includes(c.category))
      .map((c) => ({ value: c.id, label: `～${c.char} · ${c.name_vi}`, keywords: `${c.kana} ${c.char}` })),
  })).filter((g) => g.options.length > 0),
];
const changedCount = ctrItems.filter((i) => i.tags.changed === 1).length;

// Trạng thái bộ lọc trên URL (tag giả "ui-…" chỉ dùng để đọc/ghi query, không lọc trực tiếp)
const params: ParamDef[] = [
  { param: "tro", tag: "ui-counter", type: "enum", options: Object.fromEntries(counters.map((c) => [counterSlug(c), c.id])) },
  { param: "nhom", tag: "ui-group", type: "enum", options: Object.fromEntries(GROUPS.filter((g) => g.slug).map((g) => [g.slug, g.id])) },
  { param: "o", tag: "ui-mode", type: "enum", options: { "tat-ca": "m-all" } },
  { param: "loai", tag: "ui-type", type: "enum", options: { so: "l-num" } },
  { param: "nhom-so", tag: "ui-tab", type: "enum", options: Object.fromEntries(numbers.tabs.map((t) => [NUM_TAB_SLUG[t.id] ?? t.id, `t-${t.id}`])) },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLink = "rounded px-2 py-1 text-primary hover:bg-primary-soft";
---

<Base title="Luyện đếm số" description="Luyện đếm tiếng Nhật: chọn cách đọc đúng của số (trăm, nghìn, vạn, thập phân, phân số) và số + trợ số từ, có biến âm.">
  <nav slot="header" class="ml-auto flex items-center gap-2 text-sm">
    <a href={`${base}/dem-so/`} class={navLink}>Đếm số</a>
    <a href={`${base}/dem-so/bien-am/`} class={navLink}>Biến âm</a>
  </nav>

  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold">Luyện đếm số</h1>

    <div class="mt-4">
      <QuizRunner items={items} question="Đọc thế nào?" linkLabel="Xem bảng cách đọc →" wrongKinds={["n-ctr", "n-num"]} typing>
        <Fragment slot="filters">
          <Segmented
            name="q-type"
            label="Loại câu"
            options={[
              { id: "l-ctr", label: "Đếm đồ vật" },
              { id: "l-num", label: "Số" },
            ]}
            checked="l-ctr"
          />
          <div data-type="num" hidden>
            <Segmented name="q-tab" label="Nhóm số" options={numTabs} checked="t-all" wrap />
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-type="ctr">
            <span class="seg-label shrink-0">Trợ số từ:</span>
            <Combobox id="q-counter" label="Trợ số từ" groups={counterGroups} value="" placeholder="Tất cả trợ số từ" searchPlaceholder="Tìm: 本, ほん, người…" class="w-full sm:w-72" />
          </div>
          <div data-type="ctr">
            <Segmented name="q-group" label="Nhóm âm" options={GROUPS.map((g) => ({ id: g.id, label: g.label }))} checked="g-all" wrap />
          </div>
          <div data-type="ctr">
            <Segmented
              name="q-mode"
              label="Ô hỏi"
              options={[
                { id: "m-changed", label: `Cần nhớ (${changedCount})` },
                { id: "m-all", label: `Tất cả (${ctrItems.length})` },
              ]}
              checked="m-changed"
            />
          </div>
        </Fragment>
      </QuizRunner>
    </div>
  </div>

  <script type="application/json" id="q-config" set:html={JSON.stringify({ groupMap, params })} />
</Base>

<script>
  import { readFilter, writeFilter, type ParamDef } from "../../lib/quiz/params";
  import { mountQuiz } from "../../lib/quiz/runner";
  import type { Filter } from "../../lib/quiz/types";

  const cfg = JSON.parse(document.getElementById("q-config")!.textContent ?? "{}") as {
    groupMap: Record<string, string[]>;
    params: ParamDef[];
  };
  const counterInput = document.getElementById("q-counter") as HTMLInputElement;
  const checkedId = (name: string): string => document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.id ?? "";

  /** Đặt Combobox theo giá trị (không mở popup, không cướp focus). */
  function setCounter(value: string): void {
    const root = counterInput.closest<HTMLElement>("[data-combo]")!;
    const opt = root.querySelector<HTMLElement>(`.combo-opt[data-value="${CSS.escape(value)}"]`);
    if (!opt) return;
    counterInput.value = value;
    for (const o of root.querySelectorAll(".combo-opt")) o.setAttribute("aria-selected", o === opt ? "true" : "false");
    const text = root.querySelector(".combo-text");
    if (text) text.textContent = opt.dataset.label ?? "";
  }

  // URL → điều khiển
  const fromUrl = readFilter(location.search, cfg.params);
  const pick = (tag: string): string | undefined => {
    const r = fromUrl[tag];
    return Array.isArray(r) ? String(r[0]) : undefined;
  };
  const urlCounter = pick("ui-counter"), urlGroup = pick("ui-group"), urlMode = pick("ui-mode");
  const urlType = pick("ui-type"), urlTab = pick("ui-tab");
  if (urlCounter) setCounter(urlCounter);
  for (const id of [urlGroup, urlMode, urlType, urlTab]) if (id) (document.getElementById(id) as HTMLInputElement | null)?.click();

  // Điều khiển → Filter (lọc câu) và → URL
  function current(): { filter: Filter; ui: Filter } {
    // loại "Số": chỉ lọc theo nhóm số; dòng lọc trợ số từ ẩn và không ghi lên URL
    if (checkedId("q-type") === "l-num") {
      const tab = checkedId("q-tab");
      const filter: Filter = { kind: ["n-num"] };
      const ui: Filter = { "ui-type": ["l-num"] };
      if (tab !== "t-all") {
        filter.tab = [tab.replace(/^t-/, "")];
        ui["ui-tab"] = [tab];
      }
      return { filter, ui };
    }
    const counter = counterInput.value, group = checkedId("q-group"), mode = checkedId("q-mode");
    const groups = cfg.groupMap[group] ?? [];
    const filter: Filter = { kind: ["n-ctr"] };
    if (counter) filter.counter = [counter];
    if (groups.length > 0) filter.group = groups;
    if (mode !== "m-all") filter.changed = [1];
    const ui: Filter = {};
    if (counter) ui["ui-counter"] = [counter];
    if (group !== "g-all") ui["ui-group"] = [group];
    if (mode === "m-all") ui["ui-mode"] = ["m-all"];
    return { filter, ui };
  }

  const quiz = mountQuiz(document.querySelector<HTMLElement>("[data-quiz]")!);
  function apply(): void {
    const type = checkedId("q-type") === "l-num" ? "num" : "ctr";
    for (const el of document.querySelectorAll<HTMLElement>("[data-type]")) el.hidden = el.dataset.type !== type;
    const { filter, ui } = current();
    const qs = writeFilter(ui, cfg.params);
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    quiz.setFilter(filter);
  }
  counterInput.addEventListener("change", apply);
  for (const r of document.querySelectorAll<HTMLInputElement>('input[name="q-type"], input[name="q-tab"], input[name="q-group"], input[name="q-mode"]'))
    r.addEventListener("change", apply);
  apply();
</script>
