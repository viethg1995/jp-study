---
// Trang chủ: lời chào (tiêu đề + khẩu hiệu ngẫu nhiên) + thẻ dẫn vào từng phần học.
import Furigana from "../components/jp/Furigana.astro";
import Base from "../layouts/Base.astro";
import { NAV } from "../lib/nav";
import { QUOTES } from "../lib/quotes";
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from "../lib/seo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const HERO = ["日本へ行きたい。", "将来はお金持ちになりたい。"]; // tiêu đề không furigana
const sections = NAV.filter((n) => !n.home && !n.extra);
---

<Base title={`${SITE_TAGLINE} · 日本語`} fullTitle pattern jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", name: SITE_NAME, description: DEFAULT_DESCRIPTION, inLanguage: "vi", url: Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined }}>
  <section class="flex flex-col items-center py-10 text-center [container-type:inline-size] sm:py-16">
    <h1 class="hero-title hero-glow jp text-[clamp(1.25rem,6.8cqi,3rem)] leading-tight font-bold text-ink">
      {HERO.map((line) => <span class="block">{line}</span>)}
    </h1>

    <div class="mt-10 w-full max-w-xl rounded-lg border border-line bg-surface px-6 py-5">
      {
        QUOTES.map((q, i) => (
          <figure class="quote" data-quote hidden={i !== 0}>
            <blockquote class="text-lg font-semibold text-ink">“{q.vi}”</blockquote>
            <p class="mt-3 text-xl text-ink">
              <Furigana ruby={q.jp} />
            </p>
            <figcaption class="text-sm text-ink-muted">{q.jpVi}</figcaption>
          </figure>
        ))
      }
    </div>

    <a
      href={`${base}/vocabulary/`}
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 font-medium text-surface transition hover:bg-primary-strong"
    >
      Bắt đầu học từ vựng →
    </a>
  </section>

  <section class="pb-10">
    <h2 class="text-lg font-bold">Nội dung học</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.map((s) => {
          const inner = (
            <>
              <span class="jp inline-flex size-12 shrink-0 items-center justify-center rounded-lg border border-line text-2xl text-ink">
                {s.glyph}
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-2 font-semibold text-ink">
                  {s.label}
                  {s.href === null && (
                    <span class="rounded border border-line px-1 text-[10px] font-normal text-ink-faint">Sắp có</span>
                  )}
                </span>
                <span class="mt-0.5 block text-sm text-ink-muted">{s.description}</span>
              </span>
            </>
          );
          return (
            <li>
              {s.href === null ? (
                <div class="flex h-full gap-4 rounded-lg border border-line bg-surface p-4 opacity-60">{inner}</div>
              ) : (
                <a
                  href={`${base}/${s.href}`}
                  class="flex h-full gap-4 rounded-lg border border-line bg-surface p-4 transition hover:border-primary"
                >
                  {inner}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<script>
  // Mỗi lần vào trang hiện ngẫu nhiên một câu chào (không JS → câu đầu tiên).
  const quotes = document.querySelectorAll<HTMLElement>("[data-quote]");
  const pick = Math.floor(Math.random() * quotes.length);
  quotes.forEach((q, i) => {
    q.hidden = i !== pick;
  });
</script>
