---
// Luyện dịch đoạn văn N3.
import { getCollection } from "astro:content";
import PassageLevelPage from "../../../components/dich/PassageLevelPage.astro";

const passages = (await getCollection("translationPassages"))
  .map((e) => e.data)
  .filter((p) => p.level === "n3")
  .sort((a, b) => a.id.localeCompare(b.id));
---

<PassageLevelPage level="n3" passages={passages} />
