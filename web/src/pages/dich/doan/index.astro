---
// Luyện dịch — tab "Đoạn văn": thẻ N5 / N4 / N3 → mỗi cấp một trang riêng (/dich/doan/n5/…, như Kanji).
// Mỗi đoạn làm được 2 chiều (Nhật → Việt, Việt → Nhật) ở trang /dich/doan/<id>/.
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { GENRE_LABELS, LEVEL_LABELS, PASSAGE_LEVELS } from "../../../lib/translation";

const passages = (await getCollection("translationPassages")).map((e) => e.data);
const cards = PASSAGE_LEVELS.map((level) => {
  const mine = passages.filter((p) => p.level === level);
  const genres = [...new Set(mine.map((p) => p.genre))].map((g) => GENRE_LABELS[g]);
  return { level, n: mine.length, genres };
});
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const card = "flex h-full flex-col gap-1 rounded-lg border border-line bg-surface p-4 transition hover:border-primary";
---

<Base
  title="Luyện dịch đoạn văn"
  description="Luyện dịch đoạn văn tiếng Nhật ↔ tiếng Việt theo cấp JLPT N5, N4, N3 như bài đọc hiểu, có AI chấm từng câu và chỉ ra chỗ hiểu sai."
>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-bold">Luyện dịch đoạn văn</h1>
    <p class="mt-1 text-ink-muted">
      Đoạn văn ngắn như bài đọc hiểu JLPT. Mỗi đoạn có hai chiều: <b class="font-semibold text-ink">Nhật → Việt</b> (luyện đọc hiểu) và
      <b class="font-semibold text-ink">Việt → Nhật</b> (luyện viết). Dịch cả đoạn trong một ô, AI chấm từng câu.
    </p>

    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        cards.map((c) => (
          <li>
            <a href={`${base}/dich/doan/${c.level}/`} class={card}>
              <span class="text-xl font-bold text-ink">{LEVEL_LABELS[c.level]}</span>
              <span class="text-sm text-ink-muted">{c.genres.length > 0 ? c.genres.join(" · ") : "Chưa có đoạn văn"}</span>
              <span class="mt-auto pt-2 text-xs text-ink-faint">{c.n} đoạn</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
