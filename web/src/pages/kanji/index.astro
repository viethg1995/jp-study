---
// Tổng quan Kanji: thẻ N5 / N4 / N3 / Bộ thủ → mỗi phần một trang riêng (/kanji/n5/…, /kanji/bo-thu/).
// Không vẽ toàn bộ ô chữ ở đây để trang nhẹ, menu con mở thẳng trang cấp độ (không phải neo #… trên trang dài).
import { getCollection } from "astro:content";
import LevelTabs from "../../components/ui/LevelTabs.astro";
import Base from "../../layouts/Base.astro";
import { groupSize, levelGroups, n3VocabLessonMap } from "../../lib/kanji";
import { LEVELS, LEVEL_LABEL, levelTabs } from "../../lib/levels";

const all = (await getCollection("kanji")).map((k) => k.data);
const n3VocabLesson = n3VocabLessonMap(all, (await getCollection("vocabularyN3")).map((l) => l.data));
const radicals = (await getCollection("radicals")).length;
const cards = LEVELS.map((level) => {
  const { book, vocab } = levelGroups(all, n3VocabLesson, level);
  return {
    level,
    book: book ? { subtitle: book.subtitle, n: groupSize(book), lessons: book.lessons.length } : null,
    vocab: vocab ? groupSize(vocab) : 0,
  };
});
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const card = "flex h-full flex-col gap-1 rounded-lg border border-line bg-surface p-4 transition hover:border-primary";
---

<Base title="Kanji" description="Kanji N5, N4, N3 cho người Việt: âm Hán-Việt, nghĩa, âm On/Kun, số nét, bộ thủ, thứ tự nét viết và từ vựng ví dụ theo giáo trình.">
  <LevelTabs label="Cấp độ" tabs={[...levelTabs(base, "kanji", null), { label: "Bộ thủ", href: `${base}/kanji/bo-thu/`, active: false }]} />

  <h1 class="text-2xl font-bold">Kanji</h1>
  <p class="mt-1 text-sm text-ink-muted">{all.length} chữ Hán · N5 – N3</p>

  <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((c) => (
        <li>
          <a href={`${base}/kanji/${c.level}/`} class={card}>
            <span class="text-xl font-bold text-ink">{LEVEL_LABEL[c.level]}</span>
            <span class="text-sm text-ink-muted">{c.book ? c.book.subtitle : "Theo bài từ vựng"}</span>
            <span class="mt-auto pt-2 text-xs text-ink-faint">
              {c.book ? `${c.book.lessons} bài · ${c.book.n} chữ` : `${c.vocab} chữ`}
            </span>
          </a>
        </li>
      ))
    }
    <li>
      <a href={`${base}/kanji/bo-thu/`} class={card}>
        <span class="text-xl font-bold text-ink"><span class="jp" lang="ja">部</span> Bộ thủ</span>
        <span class="text-sm text-ink-muted">214 bộ Khang Hy, nhóm theo số nét</span>
        <span class="mt-auto pt-2 text-xs text-ink-faint">{radicals} bộ</span>
      </a>
    </li>
  </ul>
</Base>
