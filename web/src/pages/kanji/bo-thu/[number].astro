---
// Một bộ thủ: thông tin bộ + các chữ Hán trong dữ liệu thuộc bộ (chỉ tạo trang cho bộ có chữ).
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import type { KanjiEntry, Radical } from "../../../content.config";
import KanjiTile from "../../../components/kanji/KanjiTile.astro";
import Base from "../../../layouts/Base.astro";
import { clip } from "../../../lib/seo";

export const getStaticPaths = (async () => {
  const radicals = (await getCollection("radicals")).map((r) => r.data);
  const kanji = (await getCollection("kanji")).map((k) => k.data);
  return radicals
    .map((r) => ({ r, items: kanji.filter((k) => k.radical === r.number) }))
    .filter((x) => x.items.length > 0)
    .map((x) => ({ params: { number: String(x.r.number) }, props: x }));
}) satisfies GetStaticPaths;

interface Props {
  r: Radical;
  items: KanjiEntry[];
}
const { r, items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title={`Bộ ${r.name_vi} ${r.char}`} description={clip(`Bộ thủ ${r.char} ${r.name_vi}${r.meaning_vi ? ` (${r.meaning_vi})` : ""} — bộ số ${r.number}, ${r.strokes} nét. ${items.length} chữ Hán thuộc bộ: ${items.slice(0, 12).map((k) => k.char).join(" ")}.`)}>
  <nav slot="header" class="ml-auto text-sm">
    <a href={`${base}/kanji/bo-thu/#net-${r.strokes}`} class="rounded px-2 py-1 text-primary hover:bg-primary-soft">← Bộ thủ</a>
  </nav>

  <header class="flex items-center gap-5 rounded-lg border border-line bg-surface p-5">
    <div class="jp flex size-24 shrink-0 items-center justify-center rounded-lg border border-line text-6xl text-ink" lang="ja">
      {r.char}
    </div>
    <div>
      <h1 class="text-2xl font-bold text-ink">Bộ {r.name_vi}</h1>
      {r.meaning_vi && <p class="mt-1 text-ink">{r.meaning_vi}</p>}
      <p class="mt-1 text-sm text-ink-faint">
        Bộ số {r.number} · {r.strokes} nét
        {r.variants.length > 0 && <> · biến thể <span class="jp" lang="ja">{r.variants.join(" ")}</span></>}
      </p>
    </div>
  </header>

  <h2 class="mt-6 text-lg font-bold">
    Chữ Hán thuộc bộ <span class="jp" lang="ja">{r.char}</span>
    <span class="text-sm font-normal text-ink-faint">· {items.length} chữ</span>
  </h2>
  <ul class="mt-3 grid grid-cols-[repeat(auto-fill,minmax(4.25rem,1fr))] gap-2">
    {items.map((k) => <li><KanjiTile kanji={k} href={`${base}/kanji/${k.char}/`} /></li>)}
  </ul>
</Base>
