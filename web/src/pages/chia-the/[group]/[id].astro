---
// Bảng chia đầy đủ của một từ: thể · kết quả (furigana) · quy tắc đã áp dụng. Chữ trước/sau trong cùng nhóm.
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import RubyText from "../../../components/jp/RubyText.astro";
import Tag from "../../../components/ui/Tag.astro";
import type { ConjEntry, ConjFormDef } from "../../../content.config";
import Base from "../../../layouts/Base.astro";
import { GROUP_OF_KIND, GROUP_SLUG, KIND_LABEL, LIST_GROUPS, VERB_FORM_SECTIONS, entryPath, formPath, sourceLabel, vocabPath } from "../../../lib/conjugation";

export const getStaticPaths = (async () => {
  const forms = (await getCollection("conjForms")).map((f) => f.data).sort((a, b) => a.order - b.order);
  const all = (await getCollection("conjEntries")).map((e) => e.data).sort((a, b) => a.order - b.order);
  return all.map((e) => {
    const group = GROUP_OF_KIND[e.kind];
    const same = all.filter((x) => GROUP_OF_KIND[x.kind] === group);
    const i = same.indexOf(e);
    return {
      params: { group: GROUP_SLUG[group], id: e.vocab_id },
      props: {
        e,
        defs: forms.filter((f) => f.group === group),
        prev: same[i - 1] ?? null,
        next: same[i + 1] ?? null,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  e: ConjEntry;
  defs: ConjFormDef[];
  prev: ConjEntry | null;
  next: ConjEntry | null;
}
const { e, defs, prev, next } = Astro.props;
const group = GROUP_OF_KIND[e.kind];
const values = new Map(e.forms.map((v) => [v.form, v]));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLink = "rounded px-2 py-1 text-primary hover:bg-primary-soft";
const plain = (r: string): string => r.replace(/\{([^{}|]+)\|[^{}|]+\}/g, "$1");
// Chia nhóm hiển thị cho động từ: lịch sự (ます) · thể thường · thể khác
const SECTIONS: { title: string; ids: string[] }[] =
  group === "verb" ? VERB_FORM_SECTIONS : [{ title: "Các thể", ids: defs.map((d) => d.id) }];
---

<Base title={`${plain(e.ruby)} · Chia thể`}>
  <nav slot="header" class="ml-auto flex items-center gap-2 text-sm">
    {prev && <a href={`${base}/${entryPath(prev)}`} class={navLink}>← <RubyText ruby={plain(prev.ruby)} /></a>}
    {LIST_GROUPS.includes(group) && <a href={`${base}/chia-the/${GROUP_SLUG[group]}/`} class={navLink}>Bảng chia</a>}
    {next && <a href={`${base}/${entryPath(next)}`} class={navLink}><RubyText ruby={plain(next.ruby)} /> →</a>}
  </nav>

  <article class="mx-auto max-w-4xl">
    <header class="flex flex-wrap items-end gap-x-6 gap-y-3 rounded-lg border border-line bg-surface p-5 sm:p-6">
      <RubyText ruby={e.ruby} class="conj-head text-4xl text-ink" />
      <div class="min-w-0 flex-1">
        <p class="text-lg text-ink">{e.meaning_vi}</p>
        <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-faint">
          <Tag tone="primary">{KIND_LABEL[e.kind]}</Tag>
          {e.han_viet && <span class="tracking-wider">{e.han_viet}</span>}
          <a href={`${base}/${vocabPath(e)}`} class="text-primary hover:underline">Từ vựng {sourceLabel(e)}</a>
        </p>
      </div>
    </header>

    {
      SECTIONS.map((s) => (
        <section class="mt-6">
          <h2 class="mb-2 text-sm font-semibold text-ink-muted">{s.title}</h2>
          <div class="overflow-hidden rounded-lg border border-line bg-surface">
            <table class="w-full table-fixed text-left text-sm">
              <tbody class="divide-y divide-line">
                {s.ids.map((id) => {
                  const d = defs.find((x) => x.id === id);
                  const v = values.get(id);
                  return d ? (
                    <tr>
                      <th scope="row" class="w-1/2 px-4 py-2.5 align-baseline font-normal sm:w-[38%]">
                        <a href={`${base}/${formPath(d)}`} class="text-ink hover:text-primary hover:underline">
                          {d.name_vi}
                        </a>
                        <span class="jp ml-1.5 text-xs text-ink-faint" lang="ja">{d.name_ja}</span>
                      </th>
                      <td class="w-1/2 px-4 py-2.5 align-baseline sm:w-[30%]">
                        {v ? <RubyText ruby={v.ruby} class="text-lg font-semibold text-ink" /> : <span class="text-ink-faint">— không dùng</span>}
                      </td>
                      <td class="hidden px-4 py-2.5 align-baseline text-ink-faint sm:table-cell">
                        {v && (
                          <>
                            <span class="jp" lang="ja">{v.rule}</span>
                            {v.irregular && <span class="ml-1.5"><Tag>bất quy tắc</Tag></span>}
                          </>
                        )}
                      </td>
                    </tr>
                  ) : null;
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
    <p class="mt-4 text-xs text-ink-faint">
      Bảng chia theo quy tắc. Một vài thể có thể ít dùng với từ này vì nghĩa của từ.
    </p>
  </article>
</Base>

<style>
  .conj-head :global(rt) {
    font-size: 0.35em;
  }
</style>
