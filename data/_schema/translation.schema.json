{
  "$defs": {
    "PassageSentence": {
      "additionalProperties": false,
      "properties": {
        "ja": {
          "description": "Câu tiếng Nhật, ruby {漢字|かな} cho mọi chữ Hán, không có [[…]]",
          "minLength": 1,
          "title": "Ja",
          "type": "string"
        },
        "ja_alt": {
          "description": "Cách dịch tiếng Nhật khác cũng đúng (chữ thường) — chiều Việt → Nhật",
          "items": {
            "type": "string"
          },
          "title": "Ja Alt",
          "type": "array"
        },
        "ja_text": {
          "description": "Pipeline sinh: ja bỏ ruby (chữ thường)",
          "minLength": 1,
          "title": "Ja Text",
          "type": "string"
        },
        "note_vi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ghi chú cho AI chấm và người học",
          "title": "Note Vi"
        },
        "para": {
          "description": "Số đoạn (1, 2, …) để xuống đoạn khi hiển thị",
          "minimum": 1,
          "title": "Para",
          "type": "integer"
        },
        "vi": {
          "description": "Bản dịch tiếng Việt chuẩn",
          "minLength": 1,
          "title": "Vi",
          "type": "string"
        },
        "vi_alt": {
          "description": "Cách dịch tiếng Việt khác cũng đúng — chiều Nhật → Việt",
          "items": {
            "type": "string"
          },
          "title": "Vi Alt",
          "type": "array"
        }
      },
      "required": [
        "ja",
        "ja_text",
        "ja_alt",
        "vi",
        "vi_alt",
        "note_vi",
        "para"
      ],
      "title": "PassageSentence",
      "type": "object"
    },
    "TranslationExercise": {
      "additionalProperties": false,
      "properties": {
        "focus_vi": {
          "description": "Điểm ngữ pháp/từ vựng đề nhắm tới — hiện cho người học và gửi cho AI",
          "items": {
            "type": "string"
          },
          "title": "Focus Vi",
          "type": "array"
        },
        "grammar_refs": {
          "description": "ID ngữ pháp g-LL-N liên quan",
          "items": {
            "type": "string"
          },
          "title": "Grammar Refs",
          "type": "array"
        },
        "id": {
          "description": "t-LL-NN — khóa cache/localStorage, KHÔNG được đổi",
          "title": "Id",
          "type": "string"
        },
        "lesson": {
          "description": "Bài みんなの日本語 mà đề luyện",
          "maximum": 50,
          "minimum": 1,
          "title": "Lesson",
          "type": "integer"
        },
        "prompt_lang": {
          "description": "Ngôn ngữ của câu đề",
          "enum": [
            "vi",
            "en"
          ],
          "title": "Prompt Lang",
          "type": "string"
        },
        "review": {
          "enum": [
            "auto",
            "ai",
            "user"
          ],
          "title": "Review",
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/TranslationSentence"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Sentences",
          "type": "array"
        },
        "source": {
          "enum": [
            "ai-draft",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "title_vi": {
          "minLength": 1,
          "title": "Title Vi",
          "type": "string"
        }
      },
      "required": [
        "id",
        "lesson",
        "title_vi",
        "prompt_lang",
        "focus_vi",
        "grammar_refs",
        "sentences",
        "source",
        "review"
      ],
      "title": "TranslationExercise",
      "type": "object"
    },
    "TranslationPassage": {
      "additionalProperties": false,
      "properties": {
        "focus_vi": {
          "description": "Điểm ngữ pháp/từ vựng đáng chú ý",
          "items": {
            "type": "string"
          },
          "title": "Focus Vi",
          "type": "array"
        },
        "genre": {
          "description": "Kiểu bài đọc hiểu JLPT: thư, nhật ký, thông báo, bài viết, hội thoại, email",
          "enum": [
            "letter",
            "diary",
            "notice",
            "essay",
            "dialogue",
            "email"
          ],
          "title": "Genre",
          "type": "string"
        },
        "id": {
          "description": "p-nX-NNN — khóa cache, KHÔNG được đổi",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "n5",
            "n4",
            "n3"
          ],
          "title": "Level",
          "type": "string"
        },
        "review": {
          "enum": [
            "auto",
            "ai",
            "user"
          ],
          "title": "Review",
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/PassageSentence"
          },
          "maxItems": 20,
          "minItems": 3,
          "title": "Sentences",
          "type": "array"
        },
        "source": {
          "enum": [
            "ai-draft",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "title_ja": {
          "description": "Tiêu đề tiếng Nhật (ruby như ja)",
          "minLength": 1,
          "title": "Title Ja",
          "type": "string"
        },
        "title_vi": {
          "minLength": 1,
          "title": "Title Vi",
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "title_ja",
        "title_vi",
        "genre",
        "focus_vi",
        "sentences",
        "source",
        "review"
      ],
      "title": "TranslationPassage",
      "type": "object"
    },
    "TranslationSentence": {
      "additionalProperties": false,
      "properties": {
        "note_vi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ghi chú cho AI chấm và người học (vd: chấp nhận cả thể thường)",
          "title": "Note Vi"
        },
        "prompt": {
          "description": "Câu đề (tiếng Việt hoặc tiếng Anh, theo prompt_lang của đề)",
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "references": {
          "description": "Bản dịch mẫu tiếng Nhật (chữ thường, không ruby); nhiều cách đúng → nhiều mục",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "prompt",
        "references",
        "note_vi"
      ],
      "title": "TranslationSentence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exercises": {
      "items": {
        "$ref": "#/$defs/TranslationExercise"
      },
      "title": "Exercises",
      "type": "array"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/TranslationPassage"
      },
      "title": "Passages",
      "type": "array"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "exercises",
    "passages"
  ],
  "title": "TranslationFile",
  "type": "object"
}
