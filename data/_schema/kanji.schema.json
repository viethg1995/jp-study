    "KanjiExample": {
      "additionalProperties": false,
      "properties": {
        "kana": {
          "description": "Cách đọc cả từ, hiragana/katakana",
          "minLength": 1,
          "title": "Kana",
          "type": "string"
        },
        "meaning_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nghĩa tiếng Anh JMdict (null với từ giáo trình)",
          "title": "Meaning En"
        },
        "meaning_vi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nghĩa tiếng Việt (null: chưa dịch — web hiện meaning_en)",
          "title": "Meaning Vi"
        },
        "meaning_vi_source": {
          "anyOf": [
            {
              "enum": [
                "vocab",
                "ai-draft",
                "user"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning Vi Source"
        },
        "reading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cách đọc của riêng chữ đang xét trong từ (hiragana), vd がく",
          "title": "Reading"
        },
        "reading_type": {
          "anyOf": [
            {
              "enum": [
                "on",
                "kun"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Chữ đang xét đọc theo âm On hay Kun (null: âm đặc biệt/không xác định)",
          "title": "Reading Type"
        },
        "source": {
          "enum": [
            "vocab",
            "jmdict"
          ],
          "title": "Source",
          "type": "string"
        },
        "vocab_id": {
          "anyOf": [
            {
              "pattern": "^(mn-\\d{2}-\\d{3}|n3-\\d{3})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Từ trong giáo trình → link thẻ",
          "title": "Vocab Id"
        },
        "word": {
          "description": "Từ (dạng chữ Hán), vd 学生",
          "minLength": 1,
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word",
        "kana",
        "reading_type",
        "reading",
        "meaning_vi",
        "meaning_vi_source",
        "meaning_en",
        "vocab_id",
        "source"
      ],
      "title": "KanjiExample",
      "type": "object"
    }
