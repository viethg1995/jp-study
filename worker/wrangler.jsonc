// Cấu hình Cloudflare Worker chấm bài dịch. Hướng dẫn deploy: worker/README.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp-translation-grader",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI (hạn mức free mỗi ngày) — xóa khối này nếu không dùng
  "ai": { "binding": "AI" },

  // Giới hạn mỗi IP 6 lần chấm / 60 giây (period chỉ nhận 10 hoặc 60)
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],

  // Cache kết quả chấm (cùng đề + cùng bài làm → không gọi AI lần nữa).
  // Tạo: npx wrangler kv namespace create CACHE → dán id vào đây rồi bỏ comment.
  // "kv_namespaces": [{ "binding": "CACHE", "id": "<kv-id>" }],

  "vars": {
    // Origin của web được phép gọi (GitHub Pages + dev local), cách nhau bằng dấu phẩy, không có "/" cuối
    "ALLOWED_ORIGINS": "http://localhost:4321",
    // Thứ tự thử; nhà nào thiếu key/binding tự bị bỏ qua
    "PROVIDERS": "gemini,workers-ai,anthropic",
    // Tên model đổi theo thời gian — kiểm tra trang của từng nhà cung cấp trước khi deploy
    "GEMINI_MODEL": "gemini-2.5-flash",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "MAX_ANSWER_CHARS": "1000"
  }
  // Secret (không ghi vào file này):
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put ANTHROPIC_API_KEY   (tùy chọn)
  //   npx wrangler secret put TURNSTILE_SECRET    (tùy chọn)
}
