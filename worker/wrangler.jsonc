// Cấu hình Cloudflare Worker chấm bài dịch. Hướng dẫn deploy: worker/README.md
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jp-translation-grader",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// URL công khai: https://jp-translation-grader.viethg1995.workers.dev (không mở preview URL theo từng version)
	"workers_dev": true,
	"preview_urls": false,
	// Workers AI (hạn mức free mỗi ngày) — xóa khối này nếu không dùng
	"ai": {
		"binding": "AI"
	},
	// Giới hạn mỗi IP 6 lần chấm / 60 giây (period chỉ nhận 10 hoặc 60)
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 6,
				"period": 60
			}
		}
	],
	"vars": {
		// Origin của web được phép gọi (GitHub Pages + Cloudflare Pages + dev local), cách nhau bằng dấu phẩy, không có "/" cuối.
		// Đổi tên project Pages hoặc gắn domain riêng → thêm origin đó vào đây rồi `npm run deploy`.
		"ALLOWED_ORIGINS": "https://viethg1995.github.io,https://jp-study.pages.dev,http://localhost:4321",
		// Thứ tự thử; nhà nào thiếu key/binding tự bị bỏ qua
		"PROVIDERS": "openai-compat,gemini,workers-ai,anthropic",
		// Nhà cung cấp chính: server tương thích OpenAI (key: secret OPENAI_COMPAT_API_KEY)
		"OPENAI_COMPAT_BASE_URL": "https://llm.trambyte.store/v1",
		"OPENAI_COMPAT_MODEL": "claude-sonnet-5-5",
		// Tên model đổi theo thời gian — kiểm tra trang của từng nhà cung cấp trước khi deploy
		"GEMINI_MODEL": "gemini-2.5-flash",
		"WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"ANTHROPIC_MODEL": "claude-haiku-5-5",
		"MAX_ANSWER_CHARS": "1000"
	},
	// Cache kết quả chấm (cùng đề + cùng bài làm → không gọi AI lần nữa). Tạo: npx wrangler kv namespace create CACHE
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "33e3051c57f34ae48fd3ec6cf58905cc"
		}
	]
	// Secret (không ghi vào file này):
	//   npx wrangler secret put OPENAI_COMPAT_API_KEY   (nhà cung cấp chính)
	//   npx wrangler secret put GEMINI_API_KEY          (tùy chọn, dự phòng)
	//   npx wrangler secret put ANTHROPIC_API_KEY   (tùy chọn)
	//   npx wrangler secret put TURNSTILE_SECRET    (tùy chọn)
}